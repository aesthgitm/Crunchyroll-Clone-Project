<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111315"
    android:clickable="true"
    android:focusable="true">

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar_edit_profile"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back_edit_profile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back_edit_profile"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:text="Edit Profil"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/poppinsbold" />

    </RelativeLayout>

    <!-- Scrollable container for input elements -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar_edit_profile"
        android:layout_above="@+id/btn_save_profile"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Circular Avatar Container -->
            <RelativeLayout
                android:id="@+id/layout_edit_avatar_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginBottom="32dp">

                <!-- Main Avatar Circle -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/edit_avatar_card"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    app:cardCornerRadius="48dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FF6400">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_account"
                        app:tint="@color/white" />
                </androidx.cardview.widget.CardView>

                <!-- Floating Edit Badge -->
                <androidx.cardview.widget.CardView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignEnd="@id/edit_avatar_card"
                    android:layout_alignBottom="@id/edit_avatar_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#23252B">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/white" />
                </androidx.cardview.widget.CardView>

            </RelativeLayout>

            <!-- Nama Profil Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Profil"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppinsbold"
                    android:layout_marginBottom="8dp" />

                <!-- Stylized Input Field -->
                <EditText
                    android:id="@+id/edt_profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#23252B"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinsregular"
                    android:hint="Masukkan nama profil"
                    android:textColorHint="#5E6267"
                    android:inputType="textPersonName"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Nama Pengguna Input with ACAK button inside -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Pengguna"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppinsbold"
                    android:layout_marginBottom="8dp" />

                <!-- Relative layout to hold input + ACAK button overlap -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp">

                    <EditText
                        android:id="@+id/edt_profile_username"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#23252B"
                        android:paddingStart="16dp"
                        android:paddingEnd="80dp"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsregular"
                        android:hint="Masukkan nama pengguna"
                        android:textColorHint="#5E6267"
                        android:inputType="text"
                        android:singleLine="true" />

                    <!-- ACAK text button inside EditText at the end -->
                    <TextView
                        android:id="@+id/btn_randomize_username"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="ACAK"
                        android:textColor="#FF6400"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppinsbold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Nama pengguna hanya berupa huruf kecil, angka, dan garis bawah."
                    android:textColor="#8E9297"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinsregular" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Save Button at Bottom -->
    <TextView
        android:id="@+id/btn_save_profile"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:background="@drawable/btn_disabled_pill"
        android:gravity="center"
        android:text="Simpan"
        android:textColor="#5E6267"
        android:textSize="15sp"
        android:fontFamily="@font/poppinsbold"
        android:clickable="false"
        android:focusable="false" />

</RelativeLayout>
