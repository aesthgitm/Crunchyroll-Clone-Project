<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111315"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Banner Container -->
        <RelativeLayout
            android:id="@+id/banner_container"
            android:layout_width="match_parent"
            android:layout_height="480dp">

            <!-- ViewPager2 for swiping banners -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/banner_view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Page Indicator Dots (Horizontal bars) -->
            <LinearLayout
                android:id="@+id/banner_indicator_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="20dp">

                <View
                    android:id="@+id/indicator_1"
                    android:layout_width="16dp"
                    android:layout_height="3dp"
                    android:background="#FF6400"
                    android:layout_marginEnd="4dp"/>

                <View
                    android:id="@+id/indicator_2"
                    android:layout_width="16dp"
                    android:layout_height="3dp"
                    android:background="#55FFFFFF"
                    android:layout_marginEnd="4dp"/>

                <View
                    android:id="@+id/indicator_3"
                    android:layout_width="16dp"
                    android:layout_height="3dp"
                    android:background="#55FFFFFF"
                    android:layout_marginEnd="4dp"/>

                <View
                    android:id="@+id/indicator_4"
                    android:layout_width="16dp"
                    android:layout_height="3dp"
                    android:background="#55FFFFFF"
                    android:layout_marginEnd="4dp"/>

                <View
                    android:id="@+id/indicator_5"
                    android:layout_width="16dp"
                    android:layout_height="3dp"
                    android:background="#55FFFFFF"/>
            </LinearLayout>

            <!-- Top Header Bar Overlaid on Banner -->
            <RelativeLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_alignParentTop="true"
                android:paddingHorizontal="16dp">

                <!-- Logo Mark (Crunchyroll double crescent icon) -->
                <ImageView
                    android:id="@+id/img_logo_mark"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:src="@drawable/ic_account"
                    app:tint="#FF6400"
                    android:contentDescription="Crunchyroll"/>

                <!-- Action Buttons on Right -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_alignParentEnd="true"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btn_home_cast"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_cast"
                        app:tint="@color/white"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Cast"/>

                    <ImageView
                        android:id="@+id/btn_home_search"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/white"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Search"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>

        <!-- Continue Watching Section -->
        <LinearLayout
            android:id="@+id/section_continue_watching"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/lbl_continue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Lanjutkan Menonton"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/poppinsbold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingEnd="16dp"
                android:paddingStart="16dp" />
        </LinearLayout>

        <!-- Trending Section -->
        <LinearLayout
            android:id="@+id/section_trending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/lbl_trending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Trending In Indonesia"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/poppinsbold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_trending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingEnd="16dp"
                android:paddingStart="16dp" />
        </LinearLayout>

        <!-- Exclusive / Top Picks Section -->
        <LinearLayout
            android:id="@+id/section_exclusive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/lbl_exclusive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Top Picks For Jujutsu Kaisen Fans"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/poppinsbold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_exclusive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingEnd="16dp"
                android:paddingStart="16dp" />
        </LinearLayout>

        <!-- End of Feed Footer Section -->
        <LinearLayout
            android:id="@+id/section_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="40dp">

            <TextView
                android:id="@+id/txt_end_feed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kamu telah mencapai akhir feed."
                android:textColor="#8E9297"
                android:textSize="13sp"
                android:fontFamily="@font/poppinsregular"/>

            <Button
                android:id="@+id/btn_see_all"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_orange_pill"
                app:backgroundTint="@null"
                android:paddingHorizontal="44dp"
                android:text="Lihat Semua"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:fontFamily="@font/poppinsbold"
                android:textAllCaps="false"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
