<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Banner Image -->
    <ImageView
        android:id="@+id/banner_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- Dark Gradient Overlay for readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/placeholder_banner" />

    <!-- Banner Info Overlay at bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="16dp"
        android:paddingBottom="48dp"> <!-- Extra padding to avoid overlapping the dots -->

        <!-- Title -->
        <TextView
            android:id="@+id/banner_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anime Title"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:fontFamily="@font/poppinsbold"
            android:textStyle="bold"
            android:lineSpacingExtra="-4dp"/>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/banner_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUBTITLE"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/poppinsbold"
            android:letterSpacing="0.2"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="8dp"/>

        <!-- Metadata Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Age Rating Badge -->
            <TextView
                android:id="@+id/banner_age_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14+"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:fontFamily="@font/poppinsbold"
                android:background="@drawable/badge_background"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:layout_marginEnd="6dp"/>

            <!-- Dub/Sub Text -->
            <TextView
                android:id="@+id/banner_dub_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Sulih Suara English | Takarir"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:fontFamily="@font/poppinsregular"/>
        </LinearLayout>

        <!-- Synopsis Description -->
        <TextView
            android:id="@+id/banner_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Anime description goes here..."
            android:textColor="#D0D4D8"
            android:textSize="12sp"
            android:fontFamily="@font/poppinsregular"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="16dp"/>

        <!-- Buttons Horizontal Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Play Button -->
            <LinearLayout
                android:id="@+id/btn_play_banner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/btn_orange_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/black"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mulai Menonton E1"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppinsbold"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Add to Watchlist Circular Button -->
            <RelativeLayout
                android:id="@+id/btn_watchlist_banner"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_bookmark"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/white"
                    android:layout_centerInParent="true"
                    android:importantForAccessibility="no"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
