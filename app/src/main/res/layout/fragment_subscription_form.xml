<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_form_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/txt_form_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_form_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:text="Data Langganan"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="@font/poppinsbold" />

    </RelativeLayout>

    <!-- Form Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_bar"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:layout_marginTop="24dp">

        <TextView
            android:id="@+id/txt_plan_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Langganan: MEGA FAN"
            android:textColor="#FAB818"
            android:textSize="18sp"
            android:fontFamily="@font/poppinsbold"
            android:layout_marginBottom="32dp" />

        <!-- Name Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/edt_form_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Nama Lengkap"
                android:textColorHint="#8E9297"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/poppinsregular"
                android:paddingBottom="8dp"
                android:minHeight="48dp"
                android:inputType="textPersonName"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3A3D40"/>
        </LinearLayout>

        <!-- Email Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/edt_form_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Email"
                android:textColorHint="#8E9297"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/poppinsregular"
                android:paddingBottom="8dp"
                android:minHeight="48dp"
                android:inputType="textEmailAddress"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3A3D40"/>
        </LinearLayout>

        <!-- Password Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="40dp">

            <EditText
                android:id="@+id/edt_form_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Kata Sandi"
                android:textColorHint="#8E9297"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/poppinsregular"
                android:paddingBottom="8dp"
                android:minHeight="48dp"
                android:inputType="textPassword"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3A3D40"/>
        </LinearLayout>

        <!-- Submit Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_form_submit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_disabled_pill"
            android:text="KIRIM"
            android:textColor="#55575A"
            android:fontFamily="@font/poppinsbold"
            android:textSize="15sp"
            android:textAllCaps="true"
            android:enabled="false" />

    </LinearLayout>

</RelativeLayout>
