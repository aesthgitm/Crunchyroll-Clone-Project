<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111315"
    android:clickable="true"
    android:focusable="true">

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar_change_password"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back_change_password"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back_change_password"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:text="Ubah Kata Sandi"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/poppinsbold" />

    </RelativeLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar_change_password"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Crunchyroll Logo -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_account"
                app:tint="#FF6400"
                android:scaleType="fitCenter" />

            <!-- Crunchyroll text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Crunchyroll"
                android:textColor="#FF6400"
                android:textSize="18sp"
                android:fontFamily="@font/poppinsbold" />

            <!-- Main title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Buat Kata Sandi Baru"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:fontFamily="@font/poppinsbold"
                android:gravity="center" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Untuk melindungi akunmu, pilih kata sandi yang mempunyai lebih dari 6 karakter."
                android:textColor="#8E9297"
                android:textSize="14sp"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3" />

            <!-- New Password field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kata Sandi Baru"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppinsregular" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="#8E9297" />

                <android.widget.EditText
                    android:id="@+id/edt_new_password"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:inputType="textPassword"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppinsregular"
                    android:hint=""
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <!-- Confirm Password field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ketik Ulang Kata Sandi Baru"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppinsregular" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="#8E9297" />

                <android.widget.EditText
                    android:id="@+id/edt_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:inputType="textPassword"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppinsregular"
                    android:hint=""
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <!-- Hint text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Gunakan minimal 6 karakter, tanpa spasi kosong"
                android:textColor="#8E9297"
                android:textSize="12sp"
                android:fontFamily="@font/poppinsregular" />

            <!-- Reset button -->
            <TextView
                android:id="@+id/btn_reset_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/btn_black_stroke_pill"
                android:gravity="center"
                android:text="RESET KATA SANDI"
                android:textColor="#5E6267"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                android:fontFamily="@font/poppinsbold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Spacer -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <!-- Footer links -->
            <TextView
                android:id="@+id/btn_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ketentuan Penggunaan"
                android:textColor="#8E9297"
                android:textSize="13sp"
                android:fontFamily="@font/poppinsregular"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp" />

            <TextView
                android:id="@+id/btn_privacy_pw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kebijakan Privasi"
                android:textColor="#8E9297"
                android:textSize="13sp"
                android:fontFamily="@font/poppinsregular"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp" />

            <TextView
                android:id="@+id/btn_cookie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Alat Persetujuan Cookie"
                android:textColor="#8E9297"
                android:textSize="13sp"
                android:fontFamily="@font/poppinsregular"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp" />

            <!-- Copyright -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="SONY PICTURES"
                android:textColor="#5E6267"
                android:textSize="11sp"
                android:fontFamily="@font/poppinsbold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="© Crunchyroll, LLC"
                android:textColor="#5E6267"
                android:textSize="11sp"
                android:fontFamily="@font/poppinsregular" />

            <!-- Language selector -->
            <LinearLayout
                android:id="@+id/btn_language_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#8E9297"
                    android:rotation="90" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="BAHASA INDONESIA"
                    android:textColor="#8E9297"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinsbold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
