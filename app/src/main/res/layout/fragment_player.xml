<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:id="@+id/player_video_container"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="#111315"
        android:layout_alignParentTop="true">

        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
            android:id="@+id/youtube_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:enableAutomaticInitialization="true" />

        <ImageView
            android:id="@+id/btn_player_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />
            
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/player_video_container"
        android:fillViewport="true"
        android:padding="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_player_anime_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JUJUTSU KAISEN"
                android:textColor="@color/color_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/txt_player_episode_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="E1 - Ryomen Sukuna"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_player_meta_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/badge_background"
                android:paddingVertical="3dp"
                android:paddingHorizontal="6dp"
                android:text="16+ • Sulih Suara | Takarir"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_player_like"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="8dp"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/img_player_like"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_smile"
                        android:tint="@color/white" />
                    <TextView
                        android:id="@+id/txt_player_like_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="28"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_player_dislike"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/img_player_dislike"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_broken_heart"
                        android:tint="@color/white" />
                    <TextView
                        android:id="@+id/txt_player_dislike_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="2"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btn_player_download"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_download"
                    android:tint="@color/white"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Download Video" />

                <ImageView
                    android:id="@+id/btn_player_more_options"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_more"
                    android:tint="@color/white"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More Options" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_player_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Keterangan deskripsi..."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2" />

            <TextView
                android:id="@+id/btn_player_read_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Baca Lainnya"
                android:textColor="@color/color_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_line"
                android:layout_marginVertical="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Episode Berikutnya"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <RelativeLayout
                android:id="@+id/container_next_episode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_bar_background"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <RelativeLayout
                    android:id="@+id/layout_next_ep_thumbnail"
                    android:layout_width="120dp"
                    android:layout_height="70dp"
                    android:layout_alignParentStart="true"
                    android:background="#2E3033">

                    <ImageView
                        android:id="@+id/img_next_ep_thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Next Episode Thumbnail" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_play"
                        android:tint="@color/white" />

                    <TextView
                        android:id="@+id/txt_next_ep_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="4dp"
                        android:background="#B3000000"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="23m"
                        android:textColor="@color/white"
                        android:textSize="10sp" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/txt_next_ep_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/layout_next_ep_thumbnail"
                    android:layout_marginStart="12dp"
                    android:layout_centerVertical="true"
                    android:text="2. For Myself"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_toStartOf="@+id/btn_next_ep_download" />

                <ImageView
                    android:id="@+id/btn_next_ep_download"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_download"
                    android:tint="@color/white"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </RelativeLayout>

            <TextView
                android:id="@+id/btn_player_all_episodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                android:text="Semua Episode"
                android:textColor="@color/color_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>