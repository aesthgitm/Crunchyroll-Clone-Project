<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Video Player Container (Fixed 16:9 ratio approx. 240dp) -->
    <RelativeLayout
        android:id="@+id/player_video_container"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="#111315"
        android:layout_alignParentTop="true">

        <!-- Actual Video View -->
        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true" />

        <!-- Black overlay when controls are visible -->
        <View
            android:id="@+id/player_controls_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <!-- Overlay Controls View -->
        <RelativeLayout
            android:id="@+id/player_controls_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Top Toolbar -->
            <RelativeLayout
                android:id="@+id/player_top_toolbar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:paddingHorizontal="12dp">

                <!-- Back Arrow -->
                <ImageView
                    android:id="@+id/btn_player_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/white"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back" />

                <!-- Toolbar controls on the right -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Next Episode Icon button -->
                    <ImageView
                        android:id="@+id/btn_player_toolbar_next_ep"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_play"
                        android:tint="@color/white"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next Episode" />

                    <!-- Cast Button -->
                    <ImageView
                        android:id="@+id/btn_player_cast"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_cast"
                        android:tint="@color/white"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Chromecast" />

                    <!-- Settings gear -->
                    <ImageView
                        android:id="@+id/btn_player_settings"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/white"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Settings" />

                    <!-- Fullscreen/Maximize -->
                    <ImageView
                        android:id="@+id/btn_player_fullscreen"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_grid"
                        android:tint="@color/white"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Fullscreen" />

                </LinearLayout>

            </RelativeLayout>

            <!-- Center Controls (Rewind 10s, Play/Pause, Forward 10s) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Rewind 10s -->
                <RelativeLayout
                    android:id="@+id/btn_player_rewind_10"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_circle_bookmark"
                    android:backgroundTint="#40FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="⟲ 10"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Big Play/Pause Toggle -->
                <RelativeLayout
                    android:id="@+id/btn_player_play_pause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_bookmark"
                    android:backgroundTint="#80FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/img_player_play_pause"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_play"
                        android:tint="@color/white" />
                </RelativeLayout>

                <!-- Forward 10s -->
                <RelativeLayout
                    android:id="@+id/btn_player_forward_10"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_circle_bookmark"
                    android:backgroundTint="#40FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="⟳ 10"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>

            </LinearLayout>

            <!-- Bottom Control Info (Seekbar, timers) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:paddingBottom="4dp"
                android:paddingHorizontal="12dp">

                <!-- Current playback time -->
                <TextView
                    android:id="@+id/txt_player_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:text="0:00"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <!-- Total duration -->
                <TextView
                    android:id="@+id/txt_player_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:text="0:00"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <!-- SeekBar Progress -->
                <SeekBar
                    android:id="@+id/seekbar_player_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txt_player_current_time"
                    android:layout_marginTop="2dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:max="1000"
                    android:progressTint="@color/color_primary"
                    android:thumbTint="@color/color_primary"
                    android:progressBackgroundTint="@color/grey_text_disabled" />

            </RelativeLayout>

        </RelativeLayout>

    </RelativeLayout>

    <!-- Scrollable content below video player -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/player_video_container"
        android:fillViewport="true"
        android:padding="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Anime Category/Title (Orange) -->
            <TextView
                android:id="@+id/txt_player_anime_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JUJUTSU KAISEN"
                android:textColor="@color/color_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <!-- Episode Title -->
            <TextView
                android:id="@+id/txt_player_episode_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="E1 - Ryomen Sukuna"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Badge / Info metadata row -->
            <TextView
                android:id="@+id/txt_player_meta_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/badge_background"
                android:paddingVertical="3dp"
                android:paddingHorizontal="6dp"
                android:text="16+ • Sulih Suara | Takarir"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Engagement Action row (Like, Dislike, Download, More) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Like Action -->
                <LinearLayout
                    android:id="@+id/btn_player_like"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="8dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_player_like"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_smile"
                        android:tint="@color/white" />

                    <TextView
                        android:id="@+id/txt_player_like_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="28"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Dislike Action -->
                <LinearLayout
                    android:id="@+id/btn_player_dislike"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_player_dislike"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_broken_heart"
                        android:tint="@color/white" />

                    <TextView
                        android:id="@+id/txt_player_dislike_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="2"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Download Action -->
                <ImageView
                    android:id="@+id/btn_player_download"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_download"
                    android:tint="@color/white"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Download Video" />

                <!-- More Options -->
                <ImageView
                    android:id="@+id/btn_player_more_options"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_more"
                    android:tint="@color/white"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More Options" />

            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/txt_player_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Keterangan deskripsi mengenai episode anime yang dimainkan akan ditampilkan di sini dengan detail..."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2" />

            <TextView
                android:id="@+id/btn_player_read_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Baca Lainnya"
                android:textColor="@color/color_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_line"
                android:layout_marginVertical="16dp" />

            <!-- Next Episode Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Episode Berikutnya"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Next Episode Container (Horizontal Item layout) -->
            <RelativeLayout
                android:id="@+id/container_next_episode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_bar_background"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Thumbnail -->
                <RelativeLayout
                    android:id="@+id/layout_next_ep_thumbnail"
                    android:layout_width="120dp"
                    android:layout_height="70dp"
                    android:layout_alignParentStart="true"
                    android:background="#2E3033">

                    <!-- Overlaid play button -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_play"
                        android:tint="@color/white" />

                    <!-- Duration Badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="4dp"
                        android:background="#B3000000"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="23m"
                        android:textColor="@color/white"
                        android:textSize="10sp" />
                </RelativeLayout>

                <!-- Details next to it -->
                <TextView
                    android:id="@+id/txt_next_ep_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/layout_next_ep_thumbnail"
                    android:layout_marginStart="12dp"
                    android:layout_centerVertical="true"
                    android:text="2. For Myself"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_toStartOf="@+id/btn_next_ep_download" />

                <!-- Download button for next episode -->
                <ImageView
                    android:id="@+id/btn_next_ep_download"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_download"
                    android:tint="@color/white"
                    android:background="?attr/selectableItemBackgroundBorderless" />

            </RelativeLayout>

            <!-- All Episodes Link -->
            <TextView
                android:id="@+id/btn_player_all_episodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                android:text="Semua Episode"
                android:textColor="@color/color_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
