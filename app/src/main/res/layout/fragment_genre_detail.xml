<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111315"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:id="@+id/genre_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_genre_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_genre_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:text="Genre"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/poppinsbold"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btn_genre_cast"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_cast"
                app:tint="@color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Cast"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/btn_genre_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                app:tint="@color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Search"/>
        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/genre_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/genre_toolbar"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="16dp">

        <TextView
            android:id="@+id/txt_genre_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aksi"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:fontFamily="@font/poppinsbold"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_genre_anime_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/genre_title_container"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingBottom="24dp" />

</RelativeLayout>