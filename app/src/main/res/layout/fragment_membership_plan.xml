<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111315"
    android:clickable="true"
    android:focusable="true">

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar_membership"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back_membership"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back_membership"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:text="Paket Keanggotaan"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/poppinsbold" />

    </RelativeLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar_membership"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Mascot Image -->
            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/hime_premium"
                android:scaleType="fitCenter"
                android:layout_marginTop="8dp" />

            <!-- Crown Icon + Plan Name -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_crown"
                    app:tint="#FFB300"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/txt_membership_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anggota Fan"
                    android:textColor="#FFB300"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppinsbold" />
            </LinearLayout>

            <!-- Info Rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">

                <!-- Row 1: Keanggotaan Fan / Kelola -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txt_keanggotaan_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keanggotaan Fan"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsregular"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/btn_manage_subscription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kelola"
                        android:textColor="#FF6400"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsbold"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#22FFFFFF" />

                <!-- Row 2: Ditagih Bulanan -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txt_billing_period"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ditagih Bulanan"
                        android:textColor="#FF6400"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsbold"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#22FFFFFF" />

                <!-- Row 3: Tanggal Tagihan -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tanggal Tagihan"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsregular"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/txt_billing_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02/06/26"
                        android:textColor="#8E9297"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsregular"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#22FFFFFF" />

                <!-- Row 4: Kartu Keanggotaan Digital -->
                <RelativeLayout
                    android:id="@+id/row_digital_card"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kartu Keanggotaan Digital"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsregular"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#8E9297"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#22FFFFFF" />

                <!-- Row 5: Tukarkan Kode Penawaran -->
                <RelativeLayout
                    android:id="@+id/row_redeem_code"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tukarkan Kode Penawaran"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsregular"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#8E9297"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#22FFFFFF" />

            </LinearLayout>

            <!-- Bottom Promotion Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1B1C22"
                android:padding="20dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_horizontal">

                <!-- Promotion Header -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✦✦ Penawaran Ani-May ✦✦"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppinsbold" />
                </LinearLayout>

                <!-- Promotion Description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Untuk waktu terbatas, dapatkan Mega Fan Annual seharga Rp 235.000 Rp 180.000/thn selama 1 tahun."
                    android:textColor="#8E9297"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinsregular"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.2" />

                <!-- Tingkatkan Sekarang Button -->
                <TextView
                    android:id="@+id/btn_upgrade_animay"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_orange_pill"
                    android:gravity="center"
                    android:text="Tingkatkan Sekarang"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppinsbold"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
