<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="4dp">

    <!-- Thumbnail Container (Left) -->
    <RelativeLayout
        android:id="@+id/thumbnail_container"
        android:layout_width="140dp"
        android:layout_height="80dp"
        android:layout_alignParentStart="true"
        android:background="@drawable/placeholder_poster">

        <!-- Placeholder thumbnail overlay background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#2E3136" />

        <!-- Overlay play icon in the center -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_play"
            android:tint="@color/white"
            android:alpha="0.85"
            android:contentDescription="Play Episode" />

        <!-- Progress/Duration Badge (Bottom Right of Thumbnail) -->
        <TextView
            android:id="@+id/txt_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="4dp"
            android:background="@drawable/badge_background"
            android:paddingBottom="2dp"
            android:paddingEnd="6dp"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:text="23m tersisa"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Download Icon (Right) -->
    <ImageView
        android:id="@+id/btn_episode_download"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:src="@drawable/ic_download"
        android:tint="@color/text_secondary"
        android:contentDescription="Download Episode" />

    <!-- Episode Title (Center/Right of Thumbnail) -->
    <TextView
        android:id="@+id/txt_episode_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_toEndOf="@id/thumbnail_container"
        android:layout_toStartOf="@id/btn_episode_download"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="1. Ryomen Sukuna"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</RelativeLayout>
