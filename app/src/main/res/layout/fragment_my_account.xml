<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111315"
    android:clickable="true"
    android:focusable="true">

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar_my_account"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back_my_account"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back_my_account"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:text="Akun Saya"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/poppinsbold" />

    </RelativeLayout>

    <!-- Settings Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar_my_account"
        android:layout_above="@+id/btn_account_logout"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section: PENGATURAN AKUN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENGATURAN AKUN"
                android:textColor="#8E9297"
                android:textSize="12sp"
                android:fontFamily="@font/poppinsbold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Email Row -->
            <LinearLayout
                android:id="@+id/row_acc_email"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_email"
                    app:tint="@color/white"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Email"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinsbold" />

                <TextView
                    android:id="@+id/txt_acc_email_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="advan@gmail.com"
                    android:textColor="#8E9297"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppinsregular"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#8E9297" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Sandi Row -->
            <LinearLayout
                android:id="@+id/row_acc_password"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/white"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ubah Kata Sandi"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinsbold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#8E9297" />
            </LinearLayout>


            <!-- Section: PENGATURAN APLIKASI -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENGATURAN APLIKASI"
                android:textColor="#8E9297"
                android:textSize="12sp"
                android:fontFamily="@font/poppinsbold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <!-- Streaming Seluler Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_volume"
                    app:tint="@color/white"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Streaming dengan Seluler"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinsbold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_stream_cellular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="#FF6400"
                    app:trackTint="#7F3300" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Unduh Seluler Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/white"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Unduh dengan Seluler"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinsbold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_download_cellular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="#FF6400"
                    app:trackTint="#7F3300" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Kualitas Unduhan Row -->
            <LinearLayout
                android:id="@+id/row_acc_download_quality"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/white"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kualitas Unduhan"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinsbold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tinggi"
                    android:textColor="#8E9297"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppinsregular"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#8E9297" />
            </LinearLayout>


            <!-- Section: LAINNYA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LAINNYA"
                android:textColor="#8E9297"
                android:textSize="12sp"
                android:fontFamily="@font/poppinsbold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <!-- Kebijakan Privasi Row -->
            <LinearLayout
                android:id="@+id/row_acc_privacy"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/white"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kebijakan Privasi"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinsbold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#8E9297" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Pusat Bantuan Row -->
            <LinearLayout
                android:id="@+id/row_acc_help"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_help"
                    app:tint="@color/white"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pusat Bantuan"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinsbold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#8E9297" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Hapus Akun Row -->
            <LinearLayout
                android:id="@+id/row_acc_delete"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_delete"
                    app:tint="#FF2D2D"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hapus Akun"
                    android:textColor="#FF2D2D"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinsbold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#8E9297" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Keluar Button -->
    <TextView
        android:id="@+id/btn_account_logout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:background="@drawable/btn_black_stroke_pill"
        android:gravity="center"
        android:text="Keluar"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="@font/poppinsbold"
        android:clickable="true"
        android:focusable="true" />

</RelativeLayout>
