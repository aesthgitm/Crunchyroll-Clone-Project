<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Poster Image Placeholder -->
    <RelativeLayout
        android:id="@+id/poster_image_container"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/placeholder_poster">

        <ImageView
            android:id="@+id/poster_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Anime Poster" />
    </RelativeLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/poster_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/poster_image_container"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Anime Title"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Subtitle metadata -->
    <TextView
        android:id="@+id/poster_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignWithParentIfMissing="true"
        android:layout_below="@id/poster_title"
        android:layout_toStartOf="@+id/btn_poster_more"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Sulih Suara | Takarir"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <!-- Options Icon -->
    <ImageView
        android:id="@+id/btn_poster_more"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/poster_title"
        android:src="@drawable/ic_more"
        android:tint="@color/text_secondary"
        android:contentDescription="More Options" />

</RelativeLayout>
