<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".LoginActivity">

    <!-- Top Bar with Close Icon and Centered Logo -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/closeicon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="20dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Close"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageView
            android:id="@+id/logo"
            android:layout_width="160dp"
            android:layout_height="32dp"
            android:layout_centerInParent="true"
            android:src="@drawable/gambar1"
            android:contentDescription="Crunchyroll Logo"
            android:importantForAccessibility="no"/>
    </RelativeLayout>

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/top_bar"
        android:paddingHorizontal="32dp"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:id="@+id/txtmasuk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masuk"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="@font/poppinsbold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="36dp"/>

        <!-- Email Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <EditText
                android:id="@+id/textemail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Email atau Nama Pengguna"
                android:textColorHint="#8E9297"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/poppinsregular"
                android:paddingBottom="8dp"
                android:minHeight="48dp"
                android:inputType="textEmailAddress"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3A3D40"/>
        </LinearLayout>

        <!-- Password Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="40dp">

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Kata Sandi"
                android:textColorHint="#8E9297"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/poppinsregular"
                android:paddingBottom="8dp"
                android:minHeight="48dp"
                android:inputType="textPassword"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3A3D40"/>
        </LinearLayout>

        <!-- Button Masuk -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnlogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_disabled_pill"
            android:text="MASUK"
            android:textColor="#55575A"
            android:fontFamily="@font/poppinsbold"
            android:textSize="15sp"
            android:textAllCaps="true"
            android:layout_marginBottom="24dp"/>

        <!-- Links horizontal -->
        <LinearLayout
            android:id="@+id/linearlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUPA KATA SANDI?"
                android:fontFamily="@font/poppinsbold"
                android:textColor="#FF6400"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:fontFamily="@font/poppinsbold"
                android:textColor="#FF6400"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/textbuatakun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUAT AKUN"
                android:fontFamily="@font/poppinsbold"
                android:textColor="#FF6400"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
