<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111315"
    android:clickable="true"
    android:focusable="true">

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar_restriction"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back_restriction"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back_restriction"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:text="Pembatasan Konten"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/poppinsbold" />

    </RelativeLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar_restriction"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Subtitle/Warning Info -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih tingkat pembatasan untuk menyembunyikan konten dengan rating dewasa dari profil ini."
                android:textColor="#8E9297"
                android:textSize="14sp"
                android:fontFamily="@font/poppinsregular"
                android:layout_marginBottom="24dp" />

            <!-- Option 1: Semua Konten -->
            <LinearLayout
                android:id="@+id/row_restrict_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Semua Konten"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsbold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tampilkan seluruh acara termasuk yang tidak disensor."
                        android:textColor="#8E9297"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppinsregular" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/radio_restrict_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="#FF6400" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Option 2: PG -->
            <LinearLayout
                android:id="@+id/row_restrict_pg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PG (Bimbingan Orang Tua)"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsbold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Membatasi konten dengan rating PG ke atas."
                        android:textColor="#8E9297"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppinsregular" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/radio_restrict_pg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="#FF6400" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Option 3: 12+ -->
            <LinearLayout
                android:id="@+id/row_restrict_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remaja (12+)"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsbold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Membatasi konten untuk usia di bawah 12 tahun."
                        android:textColor="#8E9297"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppinsregular" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/radio_restrict_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="#FF6400" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Option 4: 14+ -->
            <LinearLayout
                android:id="@+id/row_restrict_14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remaja Lebih Tua (14+)"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsbold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Membatasi konten untuk usia di bawah 14 tahun."
                        android:textColor="#8E9297"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppinsregular" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/radio_restrict_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="#FF6400" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Option 5: 16+ -->
            <LinearLayout
                android:id="@+id/row_restrict_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dewasa Muda (16+)"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsbold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Membatasi konten untuk usia di bawah 16 tahun."
                        android:textColor="#8E9297"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppinsregular" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/radio_restrict_16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="#FF6400" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Option 6: 18+ -->
            <LinearLayout
                android:id="@+id/row_restrict_18"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dewasa (18+)"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppinsbold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Membatasi konten untuk usia di bawah 18 tahun."
                        android:textColor="#8E9297"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppinsregular" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/radio_restrict_18"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="#FF6400" />
            </LinearLayout>

            <!-- Bottom FAQ text link -->
            <TextView
                android:id="@+id/txt_faq_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:padding="8dp"
                android:text="Pelajari lebih lanjut tentang rating usia"
                android:textColor="#FF6400"
                android:textSize="14sp"
                android:fontFamily="@font/poppinsbold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
