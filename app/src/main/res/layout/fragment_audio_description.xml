<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111315"
    android:clickable="true"
    android:focusable="true">

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar_audio_desc"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back_audio_desc"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back_audio_desc"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:text="Deskripsi Audio"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/poppinsbold" />

    </RelativeLayout>

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar_audio_desc"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Switch Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deskripsi Audio"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:fontFamily="@font/poppinsbold"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_audio_desc_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:thumbTint="@color/switch_thumb_selector"
                app:trackTint="@color/switch_track_selector" />

        </RelativeLayout>

        <!-- Description Explanation -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dengan mengaktifkan pengaturan ini, kami akan secara otomatis memutar deskripsi audio saat tersedia, termasuk dalam unduhan offline Anda."
            android:textColor="#8E9297"
            android:textSize="14sp"
            android:fontFamily="@font/poppinsregular"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.2" />

    </LinearLayout>

    <!-- Bottom Help Link -->
    <LinearLayout
        android:id="@+id/btn_audio_desc_help"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lihat "
            android:textColor="#8E9297"
            android:textSize="13sp"
            android:fontFamily="@font/poppinsregular" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pertanyaan Umum Deskripsi Audio"
            android:textColor="#FF6400"
            android:textSize="13sp"
            android:fontFamily="@font/poppinsbold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" kami untuk info lebih lanjut."
            android:textColor="#8E9297"
            android:textSize="13sp"
            android:fontFamily="@font/poppinsregular" />
    </LinearLayout>

</RelativeLayout>
